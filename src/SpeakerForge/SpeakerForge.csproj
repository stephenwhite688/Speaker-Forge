<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SpeakerForge</RootNamespace>
    <AssemblyName>SpeakerForge</AssemblyName>
    <Description>SpeakerForge network speaker engine - UPnP/DLNA, Google Cast, AirPlay renderer discovery and streaming</Description>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

</Project>
